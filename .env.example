# ── Base de données Neon ──────────────────────────────────────────────
# Connexion poolée (utilisée par l'app en runtime)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Connexion directe (utilisée par drizzle-kit pour les migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Auth admin ────────────────────────────────────────────────────────
# 32+ caractères aléatoires — générer avec : openssl rand -base64 32
SESSION_SECRET=changeme_32_chars_minimum_random_string

# ── Vercel Blob ───────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercelblob_...

# ── Google Maps Embed ─────────────────────────────────────────────────
# Clé restreinte par domaine HTTP et par l'API Maps Embed uniquement
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=AIzaSy...

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://athlora.com

# ── Scripts uniquement (ne jamais mettre sur Vercel) ─────────────────
ADMIN_NOM=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Notifications e-mail (optionnel) ─────────────────────────────────
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
